{
  "name": "smartphone-standby",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "iOS のスタンバイモードを任意のスマートフォンのブラウザで再現する Web アプリ",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "lint": "eslint .",
    "type-check": "tsc --noEmit",
    "test:unit": "vitest run"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
